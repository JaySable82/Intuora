    "travelled_df.dropna()\n",
    "travelled_df['travelled'] = travelled_df['travelled'].str.replace('My Bike', 'Bike')\n",
    "travelled_df['travelled'] = travelled_df['travelled'].str.replace('Friend\\'s Bike', 'Bike')\n",
    "travelled_df['travelled'] = travelled_df['travelled'].str.replace('EV', 'Bike')\n",
    "travelled_df['travelled'] = travelled_df['travelled'].str.replace('Local Bus', 'Bus')\n",
    "travelled_df['travelled'] = travelled_df['travelled'].str.replace('College Bus', 'Bus')\n",
    "\n",
    "grouped = travelled_df.groupby('travelled')['reached'].value_counts()\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "# calculate the total count of each category across all friendss\n",
    "total_counts = grouped.groupby(level=1).sum()\n",
    "\n",
    "# normalize the count of each category in each friends by dividing it by the total count of the category across all friendss\n",
    "normalized = grouped.groupby(level=0).transform(lambda x: x / total_counts[x.index.get_level_values(1)])\n",
    "\n",
    "# unstack the normalized data to create a DataFrame with one column per category and one row per friends\n",
    "df_normalized = normalized.unstack()\n",
    "\n",
    "# plot a bar graph of the normalized data\n",
    "ax = df_normalized.plot(kind='bar')\n",
    "\n",
    "plt.show()\n"
