    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "\n",
    "\n",
    "# group the DataFrame by 'group' column and calculate the count of each category in each group\n",
    "grouped = df_journal_sad.groupby('Before Sleeping')['Journal'].value_counts()\n",
    "\n",
    "# calculate the total count of each category across all groups\n",
    "total_counts = grouped.groupby(level=1).sum()\n",
    "\n",
    "# normalize the count of each category in each group by dividing it by the total count of the category across all groups\n",
    "normalized = grouped.groupby(level=0).transform(lambda x: x / total_counts[x.index.get_level_values(1)])\n",
    "\n",
    "# unstack the normalized data to create a DataFrame with one column per category and one row per group\n",
    "df_normalized = normalized.unstack()\n",
    "\n",
    "# plot a bar graph of the normalized data\n",
    "ax = df_normalized.plot(kind='bar')\n",
    "\n",
    "plt.show()"
   ]
